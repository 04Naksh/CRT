// Program 1: Single Inheritance

#include<iostream>
using namespace std;

class vehicle {
public:
    void start() {
        cout << "vehicle start" << "\n";
    }
};

class car : public vehicle {
public:
    void drive() {
        cout << "car is running" << "\n";
    }
};

int main() {
    car obj1;

    obj1.start();   // inherited function
    obj1.drive();

    return 0;
}


// Program 2: multilevel inheritance

#include<iostream>
using namespace std;

class vehicle {
public:
    void start() {
        cout << "vehicle start" << "\n";
    }
};

class car : public vehicle {
public:
    void drive() {
        cout << "car is running" << "\n";
    }
};
class speedometer : public car {
public:
    void speed() {
        cout << "car is running at 9999" << "\n";
    }
};





int main() {
    speedometer obj1;

    obj1.start();   // inherited function
    obj1.drive();
    obj1.speed();

    return 0;
}

//program 3 multilevel inheritance
#include<iostream>
using namespace std;

// Base class
class vehicle {
public:
    void bike() {
        cout << "Bike start" << "\n";
    }
};

// Derived class from vehicle
class car : public vehicle {
public:
    void drive() {
        cout << "Car is start" << "\n";
    }
};

// Derived class from car
class truck : public car {
public:
    void speed() {
        cout << "Truck is running at 9999" << "\n";
    }
};

int main() {

    truck obj1;

    obj1.bike();    // inherited from vehicle
    obj1.drive();   // inherited from car
    obj1.speed();   // own function

    return 0;
}

// program 4 multilevel inheritance
#include<iostream>
using namespace std;

// Base class
class papa {
public:
    void paisepapa() {
        cout << "paise dedo papa" << "\n";
    }
};

// Derived class
class mummy : public papa {
public:
    void paisemummy() {
        cout << "paise dedo mummy" << "\n";
    }
};

int main() {

    mummy m;

    m.paisepapa();   // inherited from papa
    m.paisemummy();  // own function

    return 0;
}

