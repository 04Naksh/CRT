//problem 3 protected access specifier

#include<iostream>
using namespace std;

class parent {
    protected:
    int secretcode = 1234;
    
};
class child : public parent {
    public :
    void accesslocker(){
        cout << secretcode;
        
    }
};
int main(){
    child obj1;
    obj1.accesslocker();
}

